{
  "name": "words-44-native-experiment",
  "version": "1.0.0",
  "private": true,
  "description": "Experimental native wrapper build for Words 44; does not change the production web app.",
  "scripts": {
    "build:native-web": "node scripts/build-native-web.mjs",
    "cap:sync": "npm run build:native-web && cap sync && npm run configure:android",
    "android": "cap open android",
    "test:native-web": "npm run build:native-web && node scripts/test-native-web.mjs",
    "configure:android": "node scripts/configure-android-deeplink.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.3"
  }
}
